local function sdSpawn(vp)
	local o = table.remove(sdFree) or sdNew()
	local px = vp.Y * (rng:NextNumber() < 0.12 and rand(0.035, 0.055) or rand(0.009, 0.03))
	o.x = rand(0.02, 0.98); o.y = rand(0.02, 0.9); o.y0 = o.y
	o.px = px; o.born = now; o.life = rand(2.5, 6)
	o.vy, o.tv, o.nv = 0, 0, 0
	o.slide = rng:NextNumber() < clamp(0.1 + px / vp.Y * 9, 0, 0.55)
	o.f.BackgroundTransparency = 0.8; o.st.Transparency = 0.45; o.hl.BackgroundTransparency = 0.25
	o.f.BackgroundColor3 = Color3.new(1, 1, 1)
	o.f.Position = UDim2.fromScale(o.x, o.y); o.f.Size = UDim2.fromOffset(px * 0.2, px * 0.2)
	o.f.Visible = true; o.tr.Visible = false
	SD[#SD + 1] = o
end
local function sdUpdate(vp)
	for i = #SD, 1, -1 do
		local o = SD[i]
		local age = now - o.born
		if age >= o.life or o.y > 1.06 then
			o.f.Visible = false; o.tr.Visible = false
			sdFree[#sdFree + 1] = o; rem(SD, i)
		else
			local fade = clamp((o.life - age) / 1.3, 0, 1)
			if o.slide and age > 0.35 then
				if now > o.nv then
					o.nv = now + rand(0.25, 0.8)
					o.tv = rng:NextNumber() < 0.55 and rand(0.02, 0.1) or 0
				end
				o.vy = o.vy + (o.tv - o.vy) * min(1, dt * 5)
				o.y = o.y + o.vy * dt
			end
			if age < 0.2 or o.slide or fade < 1 then
				local k = clamp(age / 0.14, 0.2, 1)
				k = 1 - (1 - k) ^ 3
				local stt = 1 + clamp(o.vy * 7, 0, 0.5)
				o.f.Size = UDim2.fromOffset(o.px * k, o.px * k * stt)
				o.f.Position = UDim2.fromScale(o.x, o.y)
				if fade < 1 then
					o.f.BackgroundTransparency = 0.8 + 0.2 * (1 - fade)
					o.st.Transparency = 0.45 + 0.55 * (1 - fade)
					o.hl.BackgroundTransparency = 0.25 + 0.75 * (1 - fade)
				end
				if o.slide and o.y - o.y0 > 0.008 then
					o.tr.Visible = true
					o.tr.Position = UDim2.fromScale(o.x, o.y0)
					o.tr.Size = UDim2.fromOffset(max(o.px * 0.3, 2), (o.y - o.y0) * vp.Y)
					o.tr.BackgroundTransparency = 0.9 + 0.1 * (1 - fade)
				end
			end
		end
	end
end

---------------------------------------------------------------- spawn rays
local function areaRay()
	local R = CFG.AreaRadius
	local a, r = rand(0, 2 * pi), R * sqrt(rng:NextNumber())
	local c = camPos + flatLook * (R * 0.4)
	local target = V3(c.X + cos(a) * r, camPos.Y, c.Z + sin(a) * r)
	local H = CFG.RoofHeight
	local res = ray(target - rainDir * H, rainDir * (H + 90))
	if res then newDrop(res, 1) end
end
local function charRay()
	local c = chars[rng:NextInteger(1, #chars)]
	if c.sh then return end
	if c.loc and (camPos - c.r.Position).Magnitude < 2.2 then return end
	local t = c.r.Position + V3(rand(-1.7, 1.7), rand(-2.8, 2.4), rand(-1.7, 1.7))
	local jit = V3(rand(-1, 1), 0, rand(-1, 1)) * rand(0, 1.2)
	local d = (rainDir + jit).Unit
	local res = ray(t - d * 9, d * 12)
	if res then newDrop(res, 1) end
end

---------------------------------------------------------------- main update
local spawnAcc, nextCam = 0, 0
local function update(delta)
	dt = clamp(delta, 1 / 240, 0.1)
	now = os.clock()
	rays, splashN = 0, 0
	cam = Workspace.CurrentCamera
	if not cam then return end
	local cf = cam.CFrame
	camPos = cf.Position
	local lk = cf.LookVector
	lookY = lk.Y
	flatLook = V3(lk.X, 0, lk.Z)
	flatLook = flatLook.Magnitude > 0.01 and flatLook.Unit or ZERO

	-- quality governor
	fpsAvg += (1 / dt - fpsAvg) * 0.04
	if CFG.AutoQuality then
		if fpsAvg < CFG.TargetFPS then q = max(0.3, q - dt * 0.15)
		elseif fpsAvg > CFG.TargetFPS + 8 then q = min(1, q + dt * 0.05) end
	else q = 1 end
	rayCap = floor(40 * q) + 10

	-- wind
	if CFG.Wind then
		local a = rad(CFG.WindDir)
		local gust = 1 + CFG.Gustiness * math.noise(now * CFG.GustSpeed, 17.3) * 2
		W = V3(sin(a), 0, cos(a)) * (CFG.WindStrength * max(gust, 0))
	else W = ZERO end
	rainDir = V3(W.X * CFG.RainSlant, -1, W.Z * CFG.RainSlant).Unit

	if filtersDirty then setFilters() end
	if now >= nextChars then nextChars = now + 0.5; refreshChars() end
	if now >= nextCam then nextCam = now + 0.25; camSh = sheltered(camPos) end
	ap = max(CFG.AppearTime, 0.02)

	-- falling streak layers follow the camera
	local up = -rainDir
	local x = (Vector3.xAxis - up * up.X).Unit
	for _, ly in ipairs(layers) do
		ly.part.CFrame = CFrame.fromMatrix(camPos + V3(0, 46, 0) + flatLook * (ly.R * ly.fwd), x, up)
	end
	updateEmitters(false)

	-- spawn
	if CFG.Enabled and not camSh then
		local want = CFG.Rate * q * dt + spawnAcc
		local n = floor(want)
		spawnAcc = want - n
		for _ = 1, min(n, 8) do
			if rays >= rayCap then break end
			if #chars > 0 and rng:NextNumber() < CFG.CharShare then charRay() else areaRay() end
		end
	else spawnAcc = 0 end

	-- statics
	for i = #S, 1, -1 do
		local o = S[i]
		local age = now - o.born
		if age >= o.life then
			vanish(o.p, V3(o.sz, o.sz * o.fl, o.sz)); rem(S, i)
		else
			if age < ap then
				o.p.Size = V3(o.sz, o.sz * o.fl, o.sz) * (0.25 + 0.75 * age / ap)
			elseif not o.full then
				o.p.Size = V3(o.sz, o.sz * o.fl, o.sz); o.full = true
			end
			local h = o.host
			if h then
				if h.Parent == nil then
					drop(o.p); rem(S, i)
				else
					local c = h.CFrame
					if c ~= o.hcf then
						local d = c * o.hcf:Inverse()
						o.hcf = c; o.cf = d * o.cf
						mv(o.p, o.cf)
					end
				end
			end
		end
	end

	-- sliders
	for i = #L, 1, -1 do
		local s = L[i]
		local status = 0
		local h = s.host
		if h then
			if h.Parent == nil then
				status = 1
			else
				local c = h.CFrame
				if c ~= s.hcf then
					local d = c * s.hcf:Inverse()
					s.hcf = c
					s.pos = d * s.pos; s.tail = d * s.tail
					s.nrm = d:VectorToWorldSpace(s.nrm)
					s.vel = d:VectorToWorldSpace(s.vel)
					s.out = d:VectorToWorldSpace(s.out)
				end
			end
		end
		if status == 0 then
			if now - s.born > s.life then
				status = 1
			else
				s.acc += dt
				if s.acc >= s.nxt and rays < rayCap then
					local hh = min(s.acc, 0.15)
					s.acc = 0; s.nxt = rand(CFG.StepMin, CFG.StepMax)
					status = stepSlider(s, hh)
				end
			end
		end
		if status == 1 then finishSlider(s); rem(L, i)
		elseif status == 2 then rem(L, i)
		else drawSlider(s) end
	end

	-- trails
	for i = #T, 1, -1 do
		local t = T[i]
		local age = now - t.born
		if age >= t.life then
			drop(t.p); rem(T, i)
		else
			local h = t.host
			if h then
				if h.Parent == nil then
					drop(t.p); rem(T, i); continue
				end
				local c = h.CFrame
				if c ~= t.hcf then
					local d = c * t.hcf:Inverse()
					t.hcf = c; t.cf = d * t.cf
					mv(t.p, t.cf)
				end
			end
			if now >= t.nu then
				local f = age / t.life
				local k = 1 - CFG.AgeTaper * f
				t.p.Size = V3(t.len, t.th * k, t.sw * k)
				t.p.Transparency = t.t0 + (1 - t.t0) * f * f * f
				t.nu = now + t.life / 10
			end
		end
	end

	-- drips
	for i = #D, 1, -1 do
		local d = D[i]
		local h = min(dt, 0.05)
		local v = d.vel + V3(0, -CFG.Gravity, 0) * h + W * (CFG.DripDrift * h)
		local spd = v.Magnitude
		if spd > CFG.Terminal then v = v * (CFG.Terminal / spd); spd = CFG.Terminal end
		local step = v * h
		local done = false
		if now - d.born > 3.5 or d.pos.Y < camPos.Y - 160 then
			done = true
		else
			local res = nil
			if rays < rayCap + 25 then res = ray(d.pos, step + v.Unit * d.sz) end
			if res then
				if res.Material ~= Enum.Material.Water then
					splash(res.Position, res.Normal, 2)
					if CFG.Relanding then newDrop(res, 1.1) end
				end
				done = true
			else
				d.pos = d.pos + step; d.vel = v
				local dirv = v / max(spd, 1e-3)
				local len = d.sz * (1 + spd / CFG.Terminal * 2.5)
				d.p.Size = V3(len, d.sz * 0.9, d.sz * 0.9)
				mv(d.p, frame(d.pos, perp(dirv), dirv))
			end
		end
		if done then drop(d.p); rem(D, i) end
	end

	-- vanishing
	for i = #V, 1, -1 do
		local v = V[i]
		local k = 1 - (now - v.t0) / 0.18
		if k <= 0 then drop(v.p); rem(V, i) else v.p.Size = v.sz * k end
	end

	-- apply moves
	if mvN > 0 then
		Workspace:BulkMoveTo(mvP, mvC, Enum.BulkMoveMode.FireCFrameChanged)
		table.clear(mvP); table.clear(mvC); mvN = 0
	end

	-- screen droplets
	local vp = cam.ViewportSize
	if CFG.Enabled and CFG.Screen and not camSh then
		local lookF = 0.4 + 0.6 * clamp(lookY * 1.5 + 0.3, 0, 1)
		sdAcc += CFG.ScreenRate * q * lookF * dt
		while sdAcc >= 1 do
			sdAcc -= 1
			if #SD < max(4, floor(CFG.ScreenMax * q)) then sdSpawn(vp) end
		end
	else sdAcc = 0 end
	sdUpdate(vp)
end

local errd = false
conns[#conns + 1] = RunService.RenderStepped:Connect(function(delta)
	if not alive then return end
	local ok, err = pcall(update, delta)
	if not ok and not errd then errd = true; warn("RealRain:", err) end
end)

---------------------------------------------------------------- look / hooks
local function applyLook()
	MAT = Enum.Material[CFG.Material]
	COL = COLORS[CFG.WaterColor] or COLORS[1]
	for _, p in ipairs(beads) do
		p.Material = MAT; p.Color = COL; p.CastShadow = CFG.CastShadow
	end
	for _, o in ipairs(SD) do o.tr.BackgroundColor3 = COL end
	for _, o in ipairs(sdFree) do o.tr.BackgroundColor3 = COL end
end

local ctrls = {}
local HOOKS = {
	Material = applyLook, WaterColor = applyLook, CastShadow = applyLook,
	Enabled = function() updateEmitters(true) end,
	FallRate = function() updateEmitters(true) end,
	FallSpeed = function() updateEmitters(true) end,
	PreciseMesh = function(v)
		if v then nextScan = 0; for _, c in ipairs(chars) do scanChar(c.m) end end
	end,
}
local function set(key, v)
	CFG[key] = v
	local h = HOOKS[key]
	if h then h(v) end
	local c = ctrls[key]
	if c then c() end
end
local function preset(name)
	local p = PRESETS[name]
	if not p then return end
	for k, v in pairs(p) do set(k, v) end
end


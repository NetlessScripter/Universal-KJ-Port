local rainF = Instance.new("Folder"); rainF.Name = "RealRain"; rainF.Parent = Workspace
local proxyF = Instance.new("Folder"); proxyF.Name = "RealRainProxies"; proxyF.Parent = Workspace

local rp, sp = RaycastParams.new(), RaycastParams.new()
rp.FilterType = Enum.RaycastFilterType.Exclude
sp.FilterType = Enum.RaycastFilterType.Exclude
local excl, proxyOf, models = {}, {}, {}
local filtersDirty = true

local function setFilters()
	local a = { rainF }
	if cam then a[#a + 1] = cam end
	for i = #excl, 1, -1 do
		if excl[i].Parent == nil then rem(excl, i) else a[#a + 1] = excl[i] end
	end
	rp.FilterDescendantsInstances = a
	local b = { rainF, proxyF }
	if cam then b[#b + 1] = cam end
	for _, m in ipairs(models) do b[#b + 1] = m end
	sp.FilterDescendantsInstances = b
	filtersDirty = false
end

local function ray(o, d)
	rays += 1
	local r = Workspace:Raycast(o, d, rp)
	if r then
		local i = r.Instance
		local base = proxyOf[i] or i
		if base.Transparency > 0.9 or base.LocalTransparencyModifier > 0.9 then return nil end
	end
	return r
end

local function sheltered(p)
	if not CFG.Shelter then return false end
	local r = Workspace:Raycast(p, -rainDir * CFG.RoofHeight, sp)
	return r ~= nil and r.Instance.Transparency < 0.8
end

local function perp(n)
	local a = n:Cross(Vector3.yAxis)
	if a.Magnitude < 0.1 then a = n:Cross(Vector3.xAxis) end
	return a.Unit
end
local function frame(pos, up, dir)
	local x = dir and (dir - up * dir:Dot(up)) or nil
	if not x or x.Magnitude < 1e-4 then x = perp(up) else x = x.Unit end
	return CFrame.fromMatrix(pos, x, up)
end

---------------------------------------------------------------- bead pool (every droplet / trail / drip is one of these)
local free, beads = {}, {}
local MAT, COL = Enum.Material.Glass, COLORS[1]

local function newBead()
	local p = Instance.new("Part")
	p.Anchored = true; p.CanCollide = false; p.CanTouch = false; p.CanQuery = false
	p.CastShadow = CFG.CastShadow; p.Material = MAT; p.Color = COL
	p.Size = V3(0.05, 0.05, 0.05)
	local m = Instance.new("SpecialMesh"); m.MeshType = Enum.MeshType.Sphere; m.Parent = p
	beads[#beads + 1] = p
	return p
end
local function getBead()
	local p = table.remove(free)
	if p then return p end
	if #beads >= CFG.MaxParts then return nil end
	return newBead()
end
local function drop(p) p.Parent = nil; free[#free + 1] = p end

local mvP, mvC, mvN = {}, {}, 0
local function mv(p, cf) mvN += 1; mvP[mvN] = p; mvC[mvN] = cf end

local S, L, T, D, V = {}, {}, {}, {}, {} -- statics, sliders, trails, drips, vanishing
local function vanish(p, size) V[#V + 1] = { p = p, t0 = now, sz = size } end

